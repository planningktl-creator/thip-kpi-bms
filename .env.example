# Optional local defaults. BMS session credentials must come from the launcher URL
# and are kept in memory only; never put tokens in this file.
VITE_BMS_APP_IDENTIFIER=THIP.KPI.BMS

# A production build needs ONE of the two data paths below, or it fails closed.
#
# 1) Normalized source view (recommended): small and fast, all 232 indicators in one
#    read, but the hospital DBA must run reporting/thip_kpi_monthly.sql first.
# VITE_BMS_KPI_SOURCE_VIEW=thip_kpi_monthly
#
# 2) Registered HOSxP foundation queries (no DBA step): the app reads HOSxP directly,
#    fans the contract out into bounded requests and bisects any request the BMS API
#    refuses. Slower and heavier on the HIS, so prefer 1) for routine operation.
# VITE_BMS_KPI_LIVE_FOUNDATION=true
#
# Local Vite development may omit both to exercise the foundation query set.
# Optional explicit gate for non-production environments:
# VITE_BMS_KPI_REQUIRE_COMPLETE_SOURCE_VIEW=true
